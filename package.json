{
  "name": "brand-intent",
  "version": "0.24.0",
  "description": "An open file format specification for making brand intent machine-readable.",
  "author": "Christophe Stoll <christophe@stoll.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiostoll/brand-intent.git"
  },
  "homepage": "https://intent.stoll.studio",
  "bin": {
    "brand-intent": "cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./parser/index.ts",
      "default": "./parser/index.ts"
    },
    "./parser": {
      "types": "./parser/index.ts",
      "default": "./parser/index.ts"
    },
    "./syntaxes/*": "./vscode-extension/syntaxes/*",
    "./package.json": "./package.json"
  },
  "types": "./parser/index.ts",
  "keywords": [
    "brand",
    "design-tokens",
    "ai",
    "specification",
    "brand-identity",
    "design-system"
  ],
  "scripts": {
    "release": "./scripts/release.sh",
    "typecheck": "tsc -p .",
    "test": "tsx tests/brandParser.test.ts && tsx tests/identityParser.test.ts && tsx tests/colorSystem.test.ts && tsx tests/icons.test.ts && tsx tests/purposeParser.test.ts && tsx tests/realBrands.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "cli/",
    "parser/",
    "skills/",
    "examples/",
    "vscode-extension/syntaxes/"
  ]
}
