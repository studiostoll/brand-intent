# weserstrasse.place
# The shop. Facts only: where it is, how many people fit, when it's open.
# Stories name it with `place:` and show its facts with {address}, {hours}, {opens}, {closes}.
# Voice belongs to krume.identity, colours to krume.brand.

id:        weserstrasse
name:      Krume
address:   Weserstraße 17, 12045 Berlin
latitude:  52.4855
longitude: 13.4297
context:   Former copy shop with one counter and three breads a day. Regulars at seven, sold out by noon on Saturdays. No seating, two benches outside.

# The regular week. A day not named is closed; naming it keeps that visible.

hours
  tue-fri: 07:00-14:00
  sat:     07:00-13:00
  sun:     closed
  mon:     closed

# The days around Christmas, with their dates: decided each year, written each year.
# A story announces them with {hours christmas}. A day the set doesn't list keeps the regular hours.

hours christmas
  2026-12-24:             07:00-12:00
  2026-12-25..2026-12-26: closed
  2026-12-31:             07:00-12:00

# Standing room at the counter, the benches outside.

capacity
  indoor:  6
  outdoor: 8
