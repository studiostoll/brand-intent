# daily-bread.purpose
# A single bread announcement - today's bread, name and facts.
# Used for daily Instagram posts: what's fresh, what's available.

id:   daily-bread
name: Daily bread

# Which compositions can render this purpose.
compositions: editorial, simple-stack

density: light
palette: dynamic

# Default goal (krume.identity) and camera framing (krume.brand) for this purpose.
goal:    craft
framing: counter

# ── Voice ──
# Purpose-specific writing rules for AI text generation.

voice
  headline-pattern: noun-first
  number-format: digit
  sentence-max: 8

# ── Identity Composition ──
# Filter the composed upstream: both audiences, primary pillars only.

scope
  audience: regulars, newcomers
  pillars:  primary

# Context: only what is genuinely specific to this content type.
# These are slot-level instructions - not voice, not production params.
context
  primary is the bread name, 1-3 words (e.g. "Rye loaf").
  secondary is the weight and price ("750 g · €5.80").
  meta is one sentence: what makes this bread specific today.
  Never describe the bread as "delicious" or "special" -
  state a fact (flour type, fermentation time, seasonal ingredient).

# ── Slots ──

slot primary
  label:      Bread name
  typography: headline
  color:      text-primary
  maxLength:  30

slot secondary
  label:      Weight & price
  typography: kicker
  color:      text-secondary
  maxLength:  25

slot meta
  label:      Description
  typography: caption
  color:      text-secondary
  maxLength:  100

slot label
  label:      Badge
  typography: label
  color:      label-fg
  maxLength:  20

# ── Examples ──
# Whole pages: all slots written together about one bread.

example
  topic: The classic rye loaf, today's bread
  label:     Fresh today
  primary:   Rye loaf
  secondary: 750 g · €5.80
  meta:      Rye 1150, 18 hours of fermentation, caraway from the Wendland.

example
  topic: The wheat blend, only on Saturdays
  label:     Saturdays only
  primary:   Wheat blend
  secondary: 500 g · €4.20
  meta:      Tipo 1 from the Drax mill, 72 % hydration.

example
  topic: New in the shop: emmer bread with walnuts
  label:     New in the shop
  primary:   Emmer walnut
  secondary: 1 kg · €7.50
  meta:      Seasonal walnuts from the weekly market, whole-grain emmer.

# A seasonal example: only picked while the `advent` window in krume.time is open.

example
  topic: Butter stollen, baked from the first Sunday of Advent
  when:  advent
  label:     Advent only
  primary:   Butter stollen
  secondary: 1 kg · €24
  meta:      Butter from Brandenburg, matured for three weeks. On the shelf from 27 November.
