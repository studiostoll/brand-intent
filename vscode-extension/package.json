{
  "name": "brand-intent-lang",
  "displayName": "Brand Intent — .identity, .brand, .format, .purpose, .composition, .story, .place, .time, .person, .group, .work",
  "description": "Syntax highlighting and autocomplete for the Brand Intent specification — .identity, .brand, .format, .purpose, .composition, .story, .time, .place, .person, .group and .work files that define brand identity, visual language, content architecture and the facts a story needs.",
  "version": "0.40.0",
  "publisher": "studiostoll",
  "author": {
    "name": "Studio Stoll",
    "url": "https://stoll.studio"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/studiostoll/brand-intent.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:brand-intent-identity",
    "onLanguage:brand-intent-brand",
    "onLanguage:brand-intent-format",
    "onLanguage:brand-intent-purpose",
    "onLanguage:brand-intent-composition",
    "onLanguage:brand-intent-story",
    "onLanguage:brand-intent-place",
    "onLanguage:brand-intent-time",
    "onLanguage:brand-intent-person",
    "onLanguage:brand-intent-group",
    "onLanguage:brand-intent-work"
  ],
  "contributes": {
    "languages": [
      {
        "id": "brand-intent-identity",
        "aliases": [
          "Brand Intent Identity"
        ],
        "extensions": [
          ".identity"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-brand",
        "aliases": [
          "Brand Intent Brand"
        ],
        "extensions": [
          ".brand"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-format",
        "aliases": [
          "Brand Intent Format"
        ],
        "extensions": [
          ".format"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-purpose",
        "aliases": [
          "Brand Intent Purpose"
        ],
        "extensions": [
          ".purpose"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-composition",
        "aliases": [
          "Brand Intent Composition"
        ],
        "extensions": [
          ".composition"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-story",
        "aliases": [
          "Brand Intent Story"
        ],
        "extensions": [
          ".story"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-place",
        "aliases": [
          "Brand Intent Place"
        ],
        "extensions": [
          ".place"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-time",
        "aliases": [
          "Brand Intent Time"
        ],
        "extensions": [
          ".time"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-person",
        "aliases": [
          "Brand Intent Person"
        ],
        "extensions": [
          ".person"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-group",
        "aliases": [
          "Brand Intent Group"
        ],
        "extensions": [
          ".group"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "brand-intent-work",
        "aliases": [
          "Brand Intent Work"
        ],
        "extensions": [
          ".work"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "brand-intent-identity",
        "scopeName": "source.brand-intent-identity",
        "path": "./syntaxes/identity.tmLanguage.json"
      },
      {
        "language": "brand-intent-brand",
        "scopeName": "source.brand-intent-brand",
        "path": "./syntaxes/brand.tmLanguage.json"
      },
      {
        "language": "brand-intent-format",
        "scopeName": "source.brand-intent-format",
        "path": "./syntaxes/format.tmLanguage.json"
      },
      {
        "language": "brand-intent-purpose",
        "scopeName": "source.brand-intent-purpose",
        "path": "./syntaxes/purpose.tmLanguage.json"
      },
      {
        "language": "brand-intent-composition",
        "scopeName": "source.brand-intent-composition",
        "path": "./syntaxes/composition.tmLanguage.json"
      },
      {
        "language": "brand-intent-story",
        "scopeName": "source.brand-intent-story",
        "path": "./syntaxes/story.tmLanguage.json"
      },
      {
        "language": "brand-intent-place",
        "scopeName": "source.brand-intent-place",
        "path": "./syntaxes/place.tmLanguage.json"
      },
      {
        "language": "brand-intent-time",
        "scopeName": "source.brand-intent-time",
        "path": "./syntaxes/time.tmLanguage.json"
      },
      {
        "language": "brand-intent-person",
        "scopeName": "source.brand-intent-person",
        "path": "./syntaxes/person.tmLanguage.json"
      },
      {
        "language": "brand-intent-group",
        "scopeName": "source.brand-intent-group",
        "path": "./syntaxes/group.tmLanguage.json"
      },
      {
        "language": "brand-intent-work",
        "scopeName": "source.brand-intent-work",
        "path": "./syntaxes/work.tmLanguage.json"
      }
    ]
  }
}
