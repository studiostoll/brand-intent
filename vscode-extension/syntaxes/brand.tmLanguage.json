    "level-header": {
      "comment": "level NAME under levels or inside a family",
      "match": "^(\\s{2,})(level)\\s+(\\S+)\\s*$",
      "captures": {
        "2": { "name": "keyword.control.brand-intent-brand" },
        "3": { "name": "entity.name.type.brand-intent-brand" }
      }
    },
    "level-slot": {
      "comment": "Level slot: ground / on-ground/text / … → p|a1|a2[.step], $ref[.step], #HEX, level.slot, required",
      "match": "^(\\s{4,})(ground|on-ground/(?:headline|text|accent|line|divider)|contrast|on-contrast|inset|on-inset/(?:text|accent)|signal|on-signal)(:\\s*)(required|#[0-9A-Fa-f]{6}|\\$[\\w-]+(?:\\.\\d+)?|(?:p|a1|a2)(?:\\.\\d+)?|[A-Za-z][\\w-]*\\.[\\w/-]+)\\s*(#\\s.*)?$",
      "captures": {
        "2": { "name": "support.type.property-name.brand-intent-brand" },
        "3": { "name": "punctuation.separator.key-value.brand-intent-brand" },
        "4": { "name": "variable.other.brand-intent-brand" },
        "5": { "name": "comment.line.number-sign.brand-intent-brand" }
      }
    },
    "family-signal": {
      "comment": "Family signal pair: signal: VALUE / VALUE",
      "match": "^(\\s{4,})(signal)(:\\s*)(\\S+)(\\s*/\\s*)(\\S+)\\s*$",
