{
  "scopeName": "source.brand-intent-work",
  "name": "Brand Intent Work",
  "patterns": [
    { "include": "#comment" },
    { "include": "#review" },
    { "include": "#date-field" },
    { "include": "#days-field" },
    { "include": "#top-field" },
    { "include": "#facts-header" },
    { "include": "#items-header" },
    { "include": "#item-hex" },
    { "include": "#item-note" },
    { "include": "#facts-line" },
    { "include": "#keyword-partial" }
  ],
  "repository": {
    "comment": {
      "match": "^#.*$",
      "name": "comment.line.number-sign.brand-intent-work"
    },
    "review": {
      "comment": "A critic's words, verbatim: by:, on: and link: first, then the words, up to the next unindented line",
      "begin": "^(review)\\s*$",
      "beginCaptures": {
        "1": { "name": "keyword.control.brand-intent-work" }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "match": "^\\s{2}(on)(:)\\s+(\\d{4}-\\d{2}-\\d{2})\\s*$",
          "captures": {
            "1": { "name": "keyword.control.brand-intent-work" },
            "2": { "name": "punctuation.separator.brand-intent-work" },
            "3": { "name": "constant.numeric.brand-intent-work" }
          }
        },
        {
          "match": "^\\s{2}(by|link)(:)\\s+(.*)$",
          "captures": {
            "1": { "name": "keyword.control.brand-intent-work" },
            "2": { "name": "punctuation.separator.brand-intent-work" },
            "3": { "name": "string.unquoted.brand-intent-work" }
          }
        },
        {
          "match": "^\\s{2}(\\S.*)$",
          "captures": {
            "1": { "name": "string.quoted.brand-intent-work" }
          }
        }
      ]
    },
    "date-field": {
      "comment": "on: MM-DD, MM-DD..MM-DD, YYYY-MM-DD, YYYY-MM-DD..YYYY-MM-DD; until: YYYY-MM-DD; time: HH:MM-HH:MM; lead: N",
      "match": "^(on|until|time|lead)(:)\\s+(\\d{4}-\\d{2}-\\d{2}(?:\\.\\.\\d{4}-\\d{2}-\\d{2})?|\\d{2}-\\d{2}(?:\\.\\.\\d{2}-\\d{2})?|\\d{2}:\\d{2}(?:-\\d{2}:\\d{2})?|\\d+)\\s*(#.*)?$",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" },
        "2": { "name": "punctuation.separator.brand-intent-work" },
        "3": { "name": "constant.numeric.brand-intent-work" },
        "4": { "name": "comment.line.number-sign.brand-intent-work" }
      }
    },
    "days-field": {
      "match": "^(days)(:)\\s+(.*)$",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" },
        "2": { "name": "punctuation.separator.brand-intent-work" },
        "3": {
          "patterns": [
            { "match": "\\b(?:mon|tue|wed|thu|fri|sat|sun)\\b", "name": "constant.language.brand-intent-work" },
            { "match": "\\s+#.*$", "name": "comment.line.number-sign.brand-intent-work" }
          ]
        }
      }
    },
    "top-field": {
      "match": "^(id|title|kind|by|when|place|price|links|photos)(:)\\s+(.*)",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" },
        "2": { "name": "punctuation.separator.brand-intent-work" },
        "3": { "name": "string.unquoted.brand-intent-work" }
      }
    },
    "facts-header": {
      "match": "^(facts)(:)\\s*$",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" },
        "2": { "name": "punctuation.separator.brand-intent-work" }
      }
    },
    "items-header": {
      "match": "^(items)(:)\\s*(cycle)?\\s*$",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" },
        "2": { "name": "punctuation.separator.brand-intent-work" },
        "3": { "name": "constant.language.brand-intent-work" }
      }
    },
    "item-hex": {
      "comment": "An item whose value is a colour: #RRGGBB  Name",
      "match": "^\\s{2}(#[0-9a-fA-F]{6})(?:\\s{2,}(\\S.*))?$",
      "captures": {
        "1": { "name": "constant.other.color.brand-intent-work" },
        "2": { "name": "entity.name.tag.brand-intent-work" }
      }
    },
    "item-note": {
      "comment": "An item's note, on 4-space lines",
      "match": "^\\s{4}(\\S.*)$",
      "captures": {
        "1": { "name": "comment.block.documentation.brand-intent-work" }
      }
    },
    "facts-line": {
      "comment": "Facts for AI writing, as written",
      "match": "^\\s{2}(\\S.*)$",
      "captures": {
        "1": { "name": "string.unquoted.brand-intent-work" }
      }
    },
    "keyword-partial": {
      "comment": "Fallback: color the keyword token on incomplete lines (while typing)",
      "match": "^(id|title|kind|by|on|days|time|lead|until|when|place|price|links|photos|facts|review)(?=:|\\s|$)",
      "captures": {
        "1": { "name": "keyword.control.brand-intent-work" }
      }
    }
  }
}
